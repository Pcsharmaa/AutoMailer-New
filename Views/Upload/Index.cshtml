@model AutoMailer.Models.ZipFileUploadVM

@{
    ViewData["Title"] = "Upload Email Excel";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <h2 class="text-center mb-4">Upload Email Excel</h2>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
        </div>
    </div>

    <div class="row justify-content-center mt-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h4 class="card-title mb-3">Upload Emails (Excel)</h4>

                    @* <form asp-controller="Upload"
                          asp-action="UploadExcelToSaveEmail"
                          method="post"
                          enctype="multipart/form-data">

                        <div class="mb-3">
                            <label class="form-label">Select Excel File (Emails)</label>
                            <input type="file"
                                   name="excelFile"
                                   class="form-control"
                                   accept=".xlsx,.xls"
                                   required />
                        </div>

                        <button type="submit" class="btn btn-dark w-100">
                            📩 Send Emails
                        </button>
                    </form> *@
                    <form asp-controller="Upload"
                          asp-action="UploadExcelToSaveEmail"
                          method="post"
                          enctype="multipart/form-data">


                        <div class="mb-3">
                            <label class="form-label">Select Excel File (Emails)</label>
                            <input type="file"
                                   name="excelFile"
                                   class="form-control"
                                   accept=".xlsx,.xls"
                                   required />
                        </div>

                        <button type="submit" class="btn btn-dark w-100">
                            📩 Send Emails
                        </button>

                    </form>


                </div>
            </div>
        </div>
    </div>
</div>